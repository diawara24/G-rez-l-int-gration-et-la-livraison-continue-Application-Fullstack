{
  "branches": ["main"],
  "tagFormat": "${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {"changelogFile": "CHANGELOG.md"}],
    ["@semantic-release/exec", {"prepareCmd": "node scripts/set-version.js ${nextRelease.version}"}],
    ["@semantic-release/git", {"assets": ["CHANGELOG.md", "frontend/package.json", "backend/build.gradle"], "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"}],
    "@semantic-release/github"
  ]
}
